generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String  @id @default(uuid())
  role        String
  email       String  @unique
  username    String  @unique
  password    String
  displayName String?
  isAdmin     Boolean @default(false)

  // Relations
  firms       Firm[]    @relation("UserToFirm")
  history     History[] // Added: Reverse relation to History
}

model Firm {
  id         String  @id @default(uuid())
  name       String
  email       String?
  status     String?
  details     String?
  pausedUntil String?

  // Relation: Assigned to a specific user (Assigned Cd)
  assignedCd String?
  assignee   User?   @relation("UserToFirm", fields: [assignedCd], references: [id])

  // Downstream Relations
  contracts         Contract[]
  contacts          Contact[]
  history           History[]
  tasks             Task[]
  firmEventStatuses FirmEventStatus[]
}

model Event {
  id       String  @id @default(uuid())
  name     String
  year     Int
  details  String?

  contracts         Contract[]
  firmEventStatuses FirmEventStatus[]
}

model FirmEventStatus {
  id      String @id @default(uuid())
  status  String @default("Not Started")

  firmId  String
  firm    Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([firmId, eventId])
}

model Contract {
  id             String   @id @default(uuid())
  status         String?
  completedSteps String[]

  firmId   String
  firm     Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)

  eventId  String
  event    Event   @relation(fields: [eventId], references: [id])
}

model Contact {
  id          String  @id @default(uuid())
  name        String
  email       String?
  phoneNumber String?
  position    String?
  isPrimary   Boolean @default(false)

  // Foreign Key
  firmId      String
  firm        Firm    @relation(fields: [firmId], references: [id])
}

model History {
  id        String    @id @default(uuid())
  details   String
  author    String?

  // DateTime handles both exact times and specific selected dates.
  // It defaults to 'right now', but you can pass any date to override it.
  timestamp DateTime  @default(now())

  // Optional until auth is wired up
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  // Existing Relation
  firmId    String
  firm      Firm     @relation(fields: [firmId], references: [id])
}
model Task {
  id       String  @id @default(uuid())
  desc     String
  isDone   Boolean @default(false)
  firmId   String
  firm     Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
}